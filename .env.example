# ---------------------------------------------------------------------------
# Goa Tourism Intelligence — environment
#
# The DETERMINISTIC engine (GUI default) and the keyless self-check
# (`python run.py --selfcheck`) need NONE of this. These settings only apply to
# the MULTI-AGENT path (create_deep_agent), which needs a model backend.
# ---------------------------------------------------------------------------

# Pick ONE backend: anthropic (cloud, default) | ollama (local, no key) | gemini
GOA_MODEL_BACKEND=anthropic

# Optional: override the model id for the chosen backend.
#   anthropic default: claude-opus-4-8   (set claude-sonnet-5 for cheaper/faster runs)
#   ollama default:    qwen2.5:7b        (phi3 / gemma3 cannot do tool-calling)
#   gemini default:    gemini-3.6-flash
# GOA_MODEL_ID=claude-sonnet-5

# --- credentials (only the one for your chosen backend is needed) ---
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
